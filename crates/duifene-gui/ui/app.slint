import { LineEdit, ListView } from "std-widgets.slint";

// 纸主题色板(对齐原 gpui 版 Duifene Paper Light)
export global Theme {
    out property <color> bg: #f7f6f2;
    out property <color> fg: #1c1917;
    out property <color> border: #e7e5de;
    out property <color> sidebar-bg: #f1efe9;
    out property <color> secondary-bg: #edebe4;
    out property <color> secondary-hover: #e5e3da;
    out property <color> muted-fg: #8a857a;
    out property <color> card-bg: #ffffff;
    out property <color> input-border: #dcd9cf;
    out property <color> primary: #1c1917;
    out property <color> primary-hover: #33302b;
    out property <color> primary-fg: #faf9f6;
    out property <color> success: #16a34a;
    out property <color> warning: #d97706;
    out property <color> danger: #dc2626;
    out property <color> info: #2563eb;
    out property <color> overlay: #1c19171a;
}

export struct EventRow {
    time: string,
    kind: int, // 0=Ok 1=Warn 2=Info
    course: string,
    text: string,
}

export struct ActivityRow {
    course: string,
    kind: string,
    time: string,
    detail: string,
    status: int, // 0=检测中 1=已签 2=失败 3=已结束
}

export struct CourseRow {
    name: string,
}

export struct StatRow {
    label: string,
    count: int,
    ratio: float, // 0..1
    color: int,
}

export global Logic {
    // 0=首页 1=课程 2=统计 3=设置
    in-out property <int> active-page: 0;
    in-out property <bool> login-open: false;
    in-out property <string> login-link;
    in property <bool> monitoring;
    in property <bool> has-cookie;
    in property <bool> session-valid;
    in property <string> login-name;
    in property <string> elapsed;
    in property <int> courses-count;
    in property <int> found-count;
    in property <int> signed-count;
    in property <[EventRow]> events;
    in property <[ActivityRow]> activities;
    in property <[CourseRow]> courses;
    in property <[StatRow]> kind-stats;
    in property <[StatRow]> result-stats;
    in property <[StatRow]> course-stats;
    // 设置:签到人数门槛(百分比 0-100)
    in property <int> signed-percent: 30;
    // 设置页输入框文本(存 config 时的字符串表示,便于 LineEdit 双向绑定)
    in-out property <string> signed-percent-text: "30";

    callback start-stop();
    callback nav(int);
    callback open-login();
    callback login-submit();
    callback login-cancel();
    callback logout();
    callback copy-auth-link();
    callback save-signed-percent-text(string);
    // 无框窗口控制
    callback titlebar-press();
    callback win-minimize();
    callback win-maximize();
    callback win-close();
}

// 活动表固定列宽(原版列序:时间/类型/课程/状态)
export global Cols {
    out property <length> time: 110px;
    out property <length> kind: 110px;
    out property <length> status: 150px;
    out property <length> event-icon: 18px;
    out property <length> event-time: 64px;
    out property <length> event-tag: 44px;
    out property <length> event-course: 52px;
}

// ===== 几何图标(纯 Path/Rectangle,不依赖字体字形) =====

component IconGrid inherits Rectangle {
    in property <color> icon-color: Theme.fg;
    width: 17px;
    height: 17px;
    Rectangle { x: 0; y: 0; width: 7.5px; height: 7.5px; border-radius: 2px; background: parent.icon-color; }
    Rectangle { x: 9.5px; y: 0; width: 7.5px; height: 7.5px; border-radius: 2px; background: parent.icon-color; }
    Rectangle { x: 0; y: 9.5px; width: 7.5px; height: 7.5px; border-radius: 2px; background: parent.icon-color; }
    Rectangle { x: 9.5px; y: 9.5px; width: 7.5px; height: 7.5px; border-radius: 2px; background: parent.icon-color; }
}

component IconBook inherits Rectangle {
    in property <color> icon-color: Theme.fg;
    width: 17px;
    height: 17px;
    Rectangle {
        x: 1px; y: 1.5px; width: 15px; height: 14px;
        border-radius: 3px;
        border-width: 1.6px;
        border-color: parent.icon-color;
        background: transparent;
    }
    Rectangle {
        x: 8px; y: 1.5px; width: 1.6px; height: 14px;
        background: parent.icon-color;
    }
}

component IconChart inherits Rectangle {
    in property <color> icon-color: Theme.fg;
    width: 17px;
    height: 17px;
    Rectangle { x: 1px; y: 9px; width: 3.6px; height: 7px; border-radius: 1.5px; background: parent.icon-color; }
    Rectangle { x: 6.7px; y: 4px; width: 3.6px; height: 12px; border-radius: 1.5px; background: parent.icon-color; }
    Rectangle { x: 12.4px; y: 0px; width: 3.6px; height: 16px; border-radius: 1.5px; background: parent.icon-color; }
}

// 设置:齿轮(圆环 + 四个方向齿)
component IconSettings inherits Rectangle {
    in property <color> icon-color: Theme.fg;
    width: 17px;
    height: 17px;
    // 外齿(上下左右)
    Rectangle { x: 7.5px; y: 0px; width: 2px; height: 3px; background: parent.icon-color; }
    Rectangle { x: 7.5px; y: 14px; width: 2px; height: 3px; background: parent.icon-color; }
    Rectangle { x: 0px; y: 7.5px; width: 3px; height: 2px; background: parent.icon-color; }
    Rectangle { x: 14px; y: 7.5px; width: 3px; height: 2px; background: parent.icon-color; }
    // 齿轮中心圆(外圈 + 内孔)
    Rectangle {
        x: 4px; y: 4px; width: 9px; height: 9px;
        border-radius: 4.5px;
        border-width: 2px;
        border-color: parent.icon-color;
        background: transparent;
    }
}

// 圆形状态勾(事件行)
component IconCheckCircle inherits Rectangle {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: Theme.success;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 12px;
            height: 12px;
            Path {
                width: 12px;
                height: 12px;
                stroke: #ffffff;
                stroke-width: 1.8px;
                commands: "M 2.5 6.2 L 5 8.7 L 9.5 3.2";
            }
        }
    }
}

component IconWarnCircle inherits Rectangle {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: Theme.warning;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 9px;
            height: 14px;
            Text {
                text: "!";
                font-size: 11px;
                font-weight: 800;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component IconInfoCircle inherits Rectangle {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: Theme.info;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 9px;
            height: 14px;
            Text {
                text: "i";
                font-size: 11px;
                font-weight: 800;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// 空状态邮件图标
component IconMail inherits Rectangle {
    width: 30px;
    height: 24px;
    Rectangle {
        x: 0; y: 0; width: 30px; height: 24px;
        border-radius: 4px;
        border-width: 1.6px;
        border-color: Theme.muted-fg;
        background: transparent;
    }
    Path {
        width: 30px;
        height: 24px;
        stroke: Theme.muted-fg;
        stroke-width: 1.6px;
        commands: "M 2 4 L 15 13 L 28 4";
    }
}

// 通用圆点
component Dot inherits Rectangle {
    in property <length> size: 8px;
    width: size;
    height: size;
    border-radius: size / 2;
}

// 纸主题按钮
component WButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> pill;
    in property <length> height-w: 34px;
    in property <length> font-size-w: 13px;
    callback clicked;
    height: height-w;
    border-radius: pill ? height-w / 2 : 8px;
    background: primary ? (ta.has-hover ? Theme.primary-hover : Theme.primary)
        : ta.has-hover ? Theme.secondary-hover : Theme.card-bg;
    border-width: primary ? 0 : 1px;
    border-color: Theme.input-border;
    HorizontalLayout {
        alignment: center;
        Text {
            text: root.label;
            font-size: font-size-w;
            font-weight: primary ? 600 : 400;
            color: primary ? Theme.primary-fg : Theme.fg;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <int> page;
    height: 38px;
    border-radius: 10px;
    background: active ? Theme.secondary-hover : (ta.has-hover ? Theme.secondary-bg : transparent);
    HorizontalLayout {
        padding-left: 18px;
        spacing: 12px;
        Rectangle {
            width: 17px;
            height: 17px;
            y: (parent.height - 17px) / 2;
            if root.page == 0: IconGrid { icon-color: Theme.fg; }
            if root.page == 1: IconBook { icon-color: Theme.fg; }
            if root.page == 2: IconChart { icon-color: Theme.fg; }
            if root.page == 3: IconSettings { icon-color: Theme.fg; }
        }
        Text {
            text: root.label;
            font-size: 14px;
            font-weight: active ? 600 : 400;
            color: Theme.fg;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Logic.nav(root.page); }
    }
}

component StatCard inherits Rectangle {
    in property <int> number;
    in property <string> unit;
    in property <string> label;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 14px;
    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 18px;
        padding-bottom: 16px;
        alignment: start;
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Text {
                text: root.number;
                font-size: 30px;
                font-weight: 800;
                color: Theme.fg;
                vertical-alignment: bottom;
            }
            Text {
                text: root.unit;
                font-size: 13px;
                color: Theme.muted-fg;
                vertical-alignment: bottom;
            }
        }
        Rectangle { height: 4px; }
        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.muted-fg;
        }
    }
}

component StatCardBar inherits Rectangle {
    in property <string> title;
    in property <[StatRow]> rows;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 14px;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 600;
            color: Theme.fg;
        }
        Rectangle {
            vertical-stretch: 1;
            if root.rows.length == 0: Text {
                text: "暂无数据";
                color: Theme.muted-fg;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ListView {
                for row in root.rows: Rectangle {
                    height: 26px;
                    background: transparent;
                    HorizontalLayout {
                        padding-right: 4px;
                        spacing: 10px;
                        Text {
                            text: row.label;
                            font-size: 13px;
                            color: Theme.fg;
                            width: 96px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            Rectangle {
                                x: 0;
                                y: (parent.height - 10px) / 2;
                                height: 10px;
                                border-radius: 5px;
                                background: row.color == 0 ? Theme.info
                                    : row.color == 1 ? Theme.success
                                    : row.color == 2 ? Theme.warning
                                    : row.color == 3 ? Theme.danger : Theme.muted-fg;
                                width: max(4px, parent.width * min(1.0, max(0.0, row.ratio)));
                            }
                        }
                        Text {
                            text: row.count;
                            font-size: 13px;
                            color: Theme.muted-fg;
                            width: 32px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "duifene-auto";
    no-frame: true;
    resize-border-width: 6px;
    min-width: 880px;
    min-height: 560px;
    preferred-width: 1200px;
    preferred-height: 800px;
    background: Theme.bg;

    // ===== 主体布局(侧边栏全高,与原版一致) =====
    HorizontalLayout {
        // 侧边栏
        Rectangle {
            width: 264px;
            background: Theme.sidebar-bg;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 14px;
                // logo 区(兼作标题栏左段)
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            y: (parent.height - 26px) / 2;
                            border-radius: 8px;
                            background: Theme.primary;
                            clip: true;
                            Path {
                                width: 26px;
                                height: 26px;
                                fill: Theme.primary-fg;
                                commands: "M 7 18.5 L 7 21.5 L 10 21.5 L 20.5 11 L 17.5 8 Z M 18.6 6.9 L 21.6 9.9 L 22.8 8.7 C 23.3 8.2 23.3 7.3 22.8 6.8 L 21.7 5.7 C 21.2 5.2 20.3 5.2 19.8 5.7 Z";
                            }
                        }
                        Text {
                            text: "duifene-auto";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                Rectangle { height: 14px; }
                NavItem { label: "首页"; page: 0; active: Logic.active-page == 0; }
                NavItem { label: "课程"; page: 1; active: Logic.active-page == 1; }
                NavItem { label: "统计"; page: 2; active: Logic.active-page == 2; }
                NavItem { label: "设置"; page: 3; active: Logic.active-page == 3; }
                Rectangle { vertical-stretch: 1; }
                // 底部:用户卡片 + 退出(原版样式)
                if Logic.has-cookie: Rectangle {
                    height: 62px;
                    background: Theme.card-bg;
                    border-radius: 14px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            y: (parent.height - 36px) / 2;
                            border-radius: 18px;
                            background: Theme.primary;
                            clip: true;
                            Rectangle { x: 12px; y: 6px; width: 12px; height: 12px; border-radius: 6px; background: Theme.primary-fg; }
                            Rectangle { x: 7px; y: 21px; width: 22px; height: 14px; border-radius: 8px; background: Theme.primary-fg; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: Logic.login-name;
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.fg;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                alignment: start;
                                Dot {
                                    size: 6px;
                                    y: (parent.height - 6px) / 2;
                                    background: Logic.session-valid ? Theme.success : Theme.warning;
                                }
                                Text {
                                    text: Logic.session-valid ? "已登录" : "待确认";
                                    font-size: 12px;
                                    color: Theme.muted-fg;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Logic.open-login(); }
                    }
                }
                if !Logic.has-cookie: WButton {
                    label: "微信登录";
                    primary: true;
                    clicked => { Logic.open-login(); }
                }
                Rectangle { height: 8px; }
                WButton {
                    label: "退出";
                    pill: true;
                    clicked => { Logic.logout(); }
                }
            }
        }
        // 内容区
        Rectangle {
            if Logic.active-page == 0: Rectangle {
                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 58px;
                    padding-bottom: 18px;
                    spacing: 10px;
                    // 三张统计卡
                    HorizontalLayout {
                        spacing: 16px;
                        height: 104px;
                        StatCard { number: Logic.courses-count; unit: "门"; label: "监控课程"; horizontal-stretch: 1; }
                        StatCard { number: Logic.signed-count; unit: "次"; label: "今日签到成功"; horizontal-stretch: 1; }
                        StatCard { number: Logic.found-count; unit: "次"; label: "今日发现签到"; horizontal-stretch: 1; }
                    }
                    Rectangle { height: 12px; }
                    Text {
                        text: "活动状态";
                        font-size: 13px;
                        color: Theme.muted-fg;
                    }
                    // 活动表
                    Rectangle {
                        vertical-stretch: 1.6;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 14px;
                        clip: true;
                        VerticalLayout {
                            spacing: 0;
                            Rectangle {
                                height: 40px;
                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    Text { text: "时间"; width: Cols.time; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
                                    Text { text: "类型"; width: Cols.kind; padding-left: 24px; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
                                    Text { text: "课程"; horizontal-stretch: 1; padding-left: 24px; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
                                    Text { text: "状态"; width: Cols.status; padding-left: 24px; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            if Logic.activities.length == 0: Rectangle {
                                vertical-stretch: 1;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 10px;
                                        IconMail {}
                                        Text {
                                            text: "暂无活动记录";
                                            color: Theme.muted-fg;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                            ListView {
                                for row in Logic.activities: Rectangle {
                                    height: 38px;
                                    background: Theme.card-bg;
                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        Text { text: row.time; width: Cols.time; font-size: 13px; color: Theme.fg; vertical-alignment: center; }
                                        Text { text: row.kind; width: Cols.kind; padding-left: 24px; font-size: 13px; color: Theme.fg; overflow: elide; vertical-alignment: center; }
                                        Text { text: row.course; horizontal-stretch: 1; padding-left: 24px; font-size: 13px; color: Theme.fg; overflow: elide; vertical-alignment: center; }
                                        Text {
                                            text: row.status == 0 ? "检测中" : row.status == 1 ? "已签" : row.status == 3 ? "已结束" : ("失败: " + row.detail);
                                            width: Cols.status;
                                            padding-left: 24px;
                                            font-size: 13px;
                                            color: row.status == 0 ? Theme.info : row.status == 1 ? Theme.success : row.status == 3 ? Theme.muted-fg : Theme.warning;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 8px; }
                    Text {
                        text: "系统消息";
                        font-size: 13px;
                        color: Theme.muted-fg;
                    }
                    // 系统消息列表
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 14px;
                        clip: true;
                        VerticalLayout {
                            padding-top: 8px;
                            padding-bottom: 78px;
                            if Logic.events.length == 0: Text {
                                text: "暂无消息";
                                color: Theme.muted-fg;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            ListView {
                                for row in Logic.events: Rectangle {
                                    height: 34px;
                                    background: ta.has-hover ? Theme.bg : Theme.card-bg;
                                    ta := TouchArea {}
                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        spacing: 12px;
                                        Rectangle {
                                            width: Cols.event-icon;
                                            height: 16px;
                                            y: (parent.height - 16px) / 2;
                                            if row.kind == 0: IconCheckCircle {}
                                            if row.kind == 1: IconWarnCircle {}
                                            if row.kind == 2: IconInfoCircle {}
                                        }
                                        Text { text: row.time; width: Cols.event-time; font-size: 13px; color: Theme.fg; vertical-alignment: center; }
                                        Text {
                                            text: row.kind == 0 ? "成功" : row.kind == 1 ? "警告" : "信息";
                                            width: Cols.event-tag;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: row.kind == 0 ? Theme.success : row.kind == 1 ? Theme.warning : Theme.info;
                                            vertical-alignment: center;
                                        }
                                        Text { text: row.course; width: Cols.event-course; font-size: 13px; color: Theme.fg; overflow: elide; vertical-alignment: center; }
                                        Text { text: row.text; font-size: 13px; color: Theme.muted-fg; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                    }
                }
                // 悬浮监控按钮(原版:底部居中圆形播放/胶囊计时)
                Rectangle {
                    width: Logic.monitoring ? 150px : 64px;
                    height: 64px;
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 24px;
                    border-radius: 32px;
                    background: fta.has-hover ? Theme.primary-hover : Theme.primary;
                    if Logic.monitoring: HorizontalLayout {
                        padding-left: 26px;
                        padding-right: 22px;
                        spacing: 10px;
                        alignment: center;
                        Dot {
                            size: 8px;
                            y: (parent.height - 8px) / 2;
                            background: Theme.success;
                        }
                        Text {
                            text: Logic.elapsed;
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.primary-fg;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 14px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                            Rectangle { x: 0; y: 0; width: 4.5px; height: 16px; border-radius: 1.5px; background: Theme.primary-fg; }
                            Rectangle { x: 9.5px; y: 0; width: 4.5px; height: 16px; border-radius: 1.5px; background: Theme.primary-fg; }
                        }
                    }
                    if !Logic.monitoring: Path {
                        width: 18px;
                        height: 20px;
                        x: (parent.width - 18px) / 2 + 2px;
                        y: (parent.height - 20px) / 2;
                        fill: Theme.primary-fg;
                        commands: "M 0 0 L 15 10 L 0 20 Z";
                    }
                    fta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Logic.start-stop(); }
                    }
                }
            }
            if Logic.active-page == 1: Rectangle {
                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 58px;
                    padding-bottom: 22px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "课程";
                            font-size: 17px;
                            font-weight: 700;
                            color: Theme.fg;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: "共 " + Logic.courses-count + " 门";
                            font-size: 13px;
                            color: Theme.muted-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 14px;
                        clip: true;
                        if Logic.courses.length == 0: Text {
                            text: "暂无课程,登录后自动获取";
                            color: Theme.muted-fg;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        ListView {
                            for row in Logic.courses: Rectangle {
                                height: 44px;
                                background: Theme.card-bg;
                                HorizontalLayout {
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 12px;
                                    Dot {
                                        size: 6px;
                                        y: (parent.height - 6px) / 2;
                                        background: Theme.info;
                                    }
                                    Text {
                                        text: row.name;
                                        font-size: 14px;
                                        color: Theme.fg;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if Logic.active-page == 2: Rectangle {
                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 58px;
                    padding-bottom: 22px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 16px;
                        height: 104px;
                        StatCard { number: Logic.courses-count; unit: "门"; label: "监控课程"; horizontal-stretch: 1; }
                        StatCard { number: Logic.signed-count; unit: "次"; label: "今日签到成功"; horizontal-stretch: 1; }
                        StatCard { number: Logic.found-count; unit: "次"; label: "今日发现签到"; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        height: 280px;
                        StatCardBar { title: "事件类型分布"; rows: Logic.kind-stats; horizontal-stretch: 1; }
                        StatCardBar { title: "事件结果"; rows: Logic.result-stats; horizontal-stretch: 1; }
                    }
                    StatCardBar {
                        title: "各课程事件数";
                        rows: Logic.course-stats;
                        vertical-stretch: 1;
                    }
                }
            }
            if Logic.active-page == 3: Rectangle {
                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-top: 58px;
                    padding-bottom: 22px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "设置";
                            font-size: 17px;
                            font-weight: 700;
                            color: Theme.fg;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }
                    // 签到人数门槛卡片
                    Rectangle {
                        height: 168px;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 14px;
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 10px;
                            Text {
                                text: "签到人数门槛";
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.fg;
                            }
                            Text {
                                text: "当已签到人数达到班级总人数的该百分比时,才自动签到(推荐 30-70%;填 0 表示不启用此限制)。";
                                font-size: 12px;
                                color: Theme.muted-fg;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 10px;
                                    height: 12px;
                                    y: (parent.height - 12px) / 2;
                                    Rectangle { x: 0; y: 0; width: 10px; height: 12px; border-radius: 2px; border-width: 1px; border-color: Theme.primary; background: transparent; }
                                    Rectangle { x: 2px; y: 3px; width: 6px; height: 6px; border-radius: 1px; background: Theme.primary; }
                                }
                                Text {
                                    text: "百分比";
                                    font-size: 13px;
                                    color: Theme.fg;
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    text <=> Logic.signed-percent-text;
                                    width: 120px;
                                }
                                Rectangle {
                                    width: 8px;
                                }
                                WButton {
                                    label: "保存";
                                    primary: true;
                                    width: 68px;
                                    clicked => {
                                        Logic.save-signed-percent-text(Logic.signed-percent-text);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== 标题栏拖动区 + 窗口控制(覆盖在内容之上,右段) =====
    TouchArea {
        x: 264px;
        y: 0;
        width: parent.width - 264px;
        height: 52px;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                Logic.titlebar-press();
            }
        }
    }
    Rectangle {
        x: parent.width - 138px;
        y: 0;
        width: 138px;
        height: 52px;
        HorizontalLayout {
            Rectangle {
                width: 44px;
                background: wta.has-hover ? Theme.secondary-hover : transparent;
                Text {
                    text: "–";
                    font-size: 14px;
                    color: Theme.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                wta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Logic.win-minimize(); }
                }
            }
            Rectangle {
                width: 44px;
                background: mta.has-hover ? Theme.secondary-hover : transparent;
                Text {
                    text: "□";
                    font-size: 12px;
                    color: Theme.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                mta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Logic.win-maximize(); }
                }
            }
            Rectangle {
                width: 50px;
                background: cta.has-hover ? Theme.danger : transparent;
                Text {
                    text: "×";
                    font-size: 17px;
                    color: cta.has-hover ? #ffffff : Theme.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                cta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Logic.win-close(); }
                }
            }
        }
    }

    // 登录对话框遮罩
    if Logic.login-open: Rectangle {
        background: Theme.overlay;
        TouchArea {
            clicked => { Logic.login-cancel(); }
        }
        Rectangle {
            width: 440px;
            height: 252px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.card-bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { text: "微信登录"; font-size: 16px; font-weight: 700; color: Theme.fg; }
                Text {
                    text: "在微信中打开授权链接,复制完整认证链接粘贴至下方输入框中";
                    font-size: 12px;
                    color: Theme.muted-fg;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 34px;
                    background: Theme.bg;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 8px;
                        Text {
                            text: "https://open.weixin.qq.com/connect/oauth2/authorize?appid=wx1b5650884f657981…";
                            font-size: 11px;
                            color: Theme.muted-fg;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        WButton {
                            label: "复制";
                            width: 52px;
                            height-w: 26px;
                            font-size-w: 12px;
                            clicked => { Logic.copy-auth-link(); }
                        }
                    }
                }
                LineEdit {
                    placeholder-text: "粘贴微信授权链接";
                    text <=> Logic.login-link;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {}
                    WButton {
                        label: "取消";
                        width: 76px;
                        clicked => { Logic.login-cancel(); }
                    }
                    WButton {
                        label: "登录";
                        primary: true;
                        width: 76px;
                        clicked => { Logic.login-submit(); }
                    }
                }
            }
        }
    }
}
